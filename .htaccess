# 's-Heerenberg Logistics B.V. - Apache Configuration
DirectoryIndex index.php index.html

ErrorDocument 404 /shipex/404.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Support extensionless URLs (e.g. /about -> /about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# Protect sensitive log files from direct HTTP browser access
<FilesMatch "^(mail-errors\.log|\.env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
